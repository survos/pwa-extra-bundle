{
    "name": "survos/pwa-extra-bundle",
    "description": "Extra tools for https://github.com/Spomky-Labs/phpwa",
    "keywords": [
        "symfony-ux",
        "pwa",
        "symfony"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.4",
        "spomky-labs/pwa-bundle": ">=1.2.5",
        "symfony/config": "^7.3||^8.0",
        "symfony/dependency-injection": "^7.3||^8.0",
        "symfony/http-kernel": "^7.3||^8.0",
        "symfony/asset-mapper": "^7.3||^8.0",
        "twig/twig": "^3.4",
        "symfony/console": "^7.3||^8.0",
        "survos/kit-bundle": "^2.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^7.3||^8.0",
        "symfony/framework-bundle": "^7.3||^8.0",
        "symfony/phpunit-bridge": "^7.3||^8.0",
        "symfony/twig-bundle": "^7.3||^8.0",
        "symfony/var-dumper": "^7.3||^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Survos\\PwaExtraBundle\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}